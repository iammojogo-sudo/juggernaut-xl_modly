{
  "id": "juggernaut-xl",
  "name": "Juggernaut XL",
  "type": "model",
  "source": "https://github.com/iammojogo-sudo/juggernaut-xl_modly",
  "description": "Juggernaut XL v9 — a photorealistic SDXL model. Create images from text, edit an existing image, or inpaint a masked area. All three nodes share one set of weights.",
  "version": "1.2.0",
  "author": "iammojogo",
  "generator_class": "JuggernautXLGenerator",
  "tags": ["text-to-image", "image-to-image", "inpainting", "sdxl", "photorealistic", "commercial-safe"],
  "nodes": [
    {
      "id": "generate",
      "name": "Juggernaut XL",
      "input": "text",
      "inputs": [],
      "output": "image",
      "hf_repo": "RunDiffusion/Juggernaut-XL-v9",
      "download_check": "unet/diffusion_pytorch_model.fp16.safetensors",
      "hf_skip_prefixes": [],
      "params_schema": [
        {
          "id": "prompt",
          "label": "Prompt",
          "type": "string",
          "default": "",
          "tooltip": "Describe the image to create."
        },
        {
          "id": "negative_prompt",
          "label": "Negative Prompt",
          "type": "string",
          "default": "",
          "tooltip": "Things to avoid. Juggernaut XL works best with none — add specifics only as needed."
        },
        {
          "id": "num_inference_steps",
          "label": "Quality Steps",
          "type": "select",
          "default": 30,
          "options": [
            {"value": 20, "label": "20 (Fast)"},
            {"value": 30, "label": "30 (Balanced)"},
            {"value": 40, "label": "40 (High)"},
            {"value": 50, "label": "50 (Maximum)"}
          ],
          "tooltip": "Juggernaut XL v9 recommends 30-40 steps."
        },
        {
          "id": "guidance_scale",
          "label": "Prompt Guidance",
          "type": "float",
          "default": 5.0,
          "min": 1.0,
          "max": 20.0,
          "step": 0.5,
          "tooltip": "Model card recommends 3-7; lower is more realistic."
        },
        {
          "id": "aspect_ratio",
          "label": "Aspect Ratio",
          "type": "select",
          "default": "1024x1024",
          "options": [
            {"value": "1024x1024", "label": "1:1 Square (1024x1024)"},
            {"value": "832x1216", "label": "2:3 Portrait (832x1216) — Recommended"},
            {"value": "1216x832", "label": "3:2 Landscape (1216x832) — Recommended"}
          ],
          "tooltip": "SDXL native resolutions. The model card recommends 832x1216 / 1216x832."
        },
        {
          "id": "seed",
          "label": "Seed",
          "type": "int",
          "default": -1,
          "min": -1,
          "max": 2147483647,
          "tooltip": "Random seed (-1 for random). Set a value for repeatable results."
        }
      ]
    },
    {
      "id": "edit",
      "name": "Juggernaut XL Edit",
      "input": "image",
      "output": "image",
      "hf_repo": "RunDiffusion/Juggernaut-XL-v9",
      "download_check": "unet/diffusion_pytorch_model.fp16.safetensors",
      "hf_skip_prefixes": [],
      "params_schema": [
        {
          "id": "prompt",
          "label": "Prompt",
          "type": "string",
          "default": "",
          "tooltip": "Describe the change to make to the connected image."
        },
        {
          "id": "negative_prompt",
          "label": "Negative Prompt",
          "type": "string",
          "default": "",
          "tooltip": "Things to avoid."
        },
        {
          "id": "strength",
          "label": "Edit Strength",
          "type": "float",
          "default": 0.7,
          "min": 0.0,
          "max": 1.0,
          "step": 0.05,
          "tooltip": "0 = no change, 1 = fully regenerate. 0.4-0.7 for a variation, higher for bigger changes."
        },
        {
          "id": "num_inference_steps",
          "label": "Quality Steps",
          "type": "select",
          "default": 30,
          "options": [
            {"value": 20, "label": "20 (Fast)"},
            {"value": 30, "label": "30 (Balanced)"},
            {"value": 40, "label": "40 (High)"},
            {"value": 50, "label": "50 (Maximum)"}
          ]
        },
        {
          "id": "guidance_scale",
          "label": "Prompt Guidance",
          "type": "float",
          "default": 5.0,
          "min": 1.0,
          "max": 20.0,
          "step": 0.5,
          "tooltip": "Model card recommends 3-7; lower is more realistic."
        },
        {
          "id": "seed",
          "label": "Seed",
          "type": "int",
          "default": -1,
          "min": -1,
          "max": 2147483647,
          "tooltip": "Random seed (-1 for random)."
        }
      ]
    },
    {
      "id": "inpaint",
      "name": "Juggernaut XL Inpaint",
      "inputs": ["image", "image"],
      "input_labels": ["Image", "Mask (white = replace)"],
      "output": "image",
      "hf_repo": "RunDiffusion/Juggernaut-XL-v9",
      "download_check": "unet/diffusion_pytorch_model.fp16.safetensors",
      "hf_skip_prefixes": [],
      "params_schema": [
        {
          "id": "prompt",
          "label": "Prompt",
          "type": "string",
          "default": "",
          "tooltip": "Describe what should appear inside the masked area."
        },
        {
          "id": "negative_prompt",
          "label": "Negative Prompt",
          "type": "string",
          "default": "",
          "tooltip": "Things to avoid."
        },
        {
          "id": "strength",
          "label": "Inpaint Strength",
          "type": "float",
          "default": 0.9,
          "min": 0.0,
          "max": 1.0,
          "step": 0.05,
          "tooltip": "How strongly the masked area is regenerated. 0.8-1.0 is typical."
        },
        {
          "id": "num_inference_steps",
          "label": "Quality Steps",
          "type": "select",
          "default": 30,
          "options": [
            {"value": 20, "label": "20 (Fast)"},
            {"value": 30, "label": "30 (Balanced)"},
            {"value": 40, "label": "40 (High)"},
            {"value": 50, "label": "50 (Maximum)"}
          ]
        },
        {
          "id": "guidance_scale",
          "label": "Prompt Guidance",
          "type": "float",
          "default": 5.0,
          "min": 1.0,
          "max": 20.0,
          "step": 0.5,
          "tooltip": "Model card recommends 3-7; lower is more realistic."
        },
        {
          "id": "seed",
          "label": "Seed",
          "type": "int",
          "default": -1,
          "min": -1,
          "max": 2147483647,
          "tooltip": "Random seed (-1 for random)."
        }
      ]
    }
  ]
}
