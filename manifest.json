{
  "id": "juggernaut-xl",
  "name": "Juggernaut XL",
  "type": "model",
  "source": "https://github.com/iammojogo-sudo/juggernaut-xl_modly",
  "description": "Juggernaut XL v9, a general-purpose SDXL image generator for creating and editing images.",
  "version": "1.1.0",
  "author": "iammojogo",
  "generator_class": "JuggernautXLGenerator",
  "tags": ["text-to-image", "image-to-image", "inpainting", "sdxl", "commercial-safe"],
  "nodes": [{
    "id": "generate",
    "name": "Juggernaut XL",
    "inputs": ["image", "image"],
    "output": "image",
    "hf_repo": "RunDiffusion/Juggernaut-XL-v9",
    "download_check": "unet/diffusion_pytorch_model.fp16.safetensors",
    "hf_skip_prefixes": [],
    "params_schema": [
      {
        "id": "mode",
        "label": "Mode",
        "type": "select",
        "default": "generate",
        "options": [
          {"value": "generate", "label": "Generate Image"},
          {"value": "img2img", "label": "Edit Image"},
          {"value": "inpaint", "label": "Inpaint Image"}
        ],
        "tooltip": "Create a new image, edit a connected image, or replace a masked area."
      },
      {
        "id": "prompt",
        "label": "Prompt",
        "type": "string",
        "default": "",
        "tooltip": "Describe the image to create or the changes to make."
      }
    ]
  }]
}
